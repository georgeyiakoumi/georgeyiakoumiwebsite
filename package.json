{
  "name": "george-yiakoumi",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next && next dev",
    "dev:local-cms": "rm -rf .next && set -a && . ./.env.local-cms && set +a && next dev",
    "dev:network": "rm -rf .next && next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:run && npm run test:e2e",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:strapi": "node scripts/test-strapi.mjs",
    "cms:dev": "cd cms && npm run develop",
    "cms:db:pull": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/cms-db-pull.mts",
    "cms:build": "cd cms && npm run build",
    "cms:start": "cd cms && npm run start",
    "purge:cloudflare": "node scripts/purge-cloudflare.mjs",
    "purge:cloudflare:all": "node scripts/purge-cloudflare.mjs --all"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@iconify-json/thesvg-color": "1.2.27",
    "@iconify/utils": "3.1.7",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.543.0",
    "motion": "^12.40.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-zoom-pan-pinch": "^4.2.0",
    "recharts": "^2.15.4",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.13",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@iconify/types": "2.0.0",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/nextjs": "^10.6.7",
    "@storybook/nextjs-vite": "^10.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "24.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-storybook": "^10.6.7",
    "jsdom": "^28.1.0",
    "playwright": "^1.61.1",
    "shadcn": "^3.7.0",
    "storybook": "^10.6.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
