# Website template. Copy to .env.local, then run `npm run dev`.
# Real values are in Netlify (Site configuration → Environment variables).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Read-only Strapi API token. Never use a full-access token here.
STRAPI_API_URL=https://portfolio-cms-n9hb.onrender.com
STRAPI_API_TOKEN=replace-me

# Shared secret for the Strapi → /api/revalidate webhook.
REVALIDATE_SECRET=replace-me

# Only needed to run `npm run purge:cloudflare` manually.
CLOUDFLARE_ZONE_ID=replace-me
CLOUDFLARE_API_TOKEN=replace-me
