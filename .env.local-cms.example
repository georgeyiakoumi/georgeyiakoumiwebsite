# Points the website at the LOCAL CMS. Copy to .env.local-cms, then run
# `npm run dev:local-cms`. Values here override .env.local.
STRAPI_API_URL=http://localhost:1337

# A read-only token created in the LOCAL Strapi admin (or by `npm run cms:db:pull`).
# Production tokens don't work locally, because local secrets are different.
STRAPI_API_TOKEN=replace-me
