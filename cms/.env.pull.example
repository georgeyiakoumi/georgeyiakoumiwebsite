# Used only by `npm run cms:db:pull` to copy production content into the local
# CMS database. Copy to cms/.env.pull (gitignored).
#
# Use the READ-ONLY role (cms_pull_readonly), never the main postgres user, and
# the Supabase SESSION pooler on port 5432 (the transaction pooler on 6543 does
# not support pg_dump). See docs/ENVIRONMENTS.md.
PULL_DATABASE_URL=postgresql://cms_pull_readonly.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
