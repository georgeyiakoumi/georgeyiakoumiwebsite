# Local CMS template. Copy to cms/.env.local, then run `npm run cms:dev`.
#
# This file is for LOCAL DEVELOPMENT ONLY. Never put production values in any
# local env file. Production secrets live only in the Render dashboard (and your
# password manager). See docs/ENVIRONMENTS.md.

HOST=0.0.0.0
PORT=1337

# Required. Marks this as the local CMS: the database must be on this machine and
# uploads stay on disk. Never set this on Render.
CMS_ENV=local

# Generate unique local values — never reuse production ones:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# APP_KEYS takes four comma-separated values.
APP_KEYS=replace-me-1,replace-me-2,replace-me-3,replace-me-4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me

# Local Postgres (e.g. Homebrew postgresql@17). Must point at localhost.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=strapi_dev
DATABASE_USERNAME=replace-me
DATABASE_PASSWORD=replace-me
DATABASE_SSL=false

# Leave Cloudinary unset locally. Without these, uploads go to cms/public/uploads
# and nothing local can create or delete files in the production media library.
# CLOUDINARY_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
